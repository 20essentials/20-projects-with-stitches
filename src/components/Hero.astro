---
import { baseUrl } from '@/utils/functions';
const logo = baseUrl('/assets/stitches.svg');
---

<section>
  <h1>
    <output>20</output> Projects With Stitches <img src={logo} alt='Logo' />
  </h1>
</section>
<style>
  section {
    height: 100vh;
  }

  @keyframes clippy {
    0% {
      clip-path: circle(0vmax at 50% 50%);
    }
    100% {
      clip-path: circle(100vmax at 50% 50%);
    }
  }

  h1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 5vmax;
    text-align: center;
    text-wrap: balance;
    color: transparent;
    background-image: var(--gradient-btn);
    background-clip: text;
    animation: clippy 4s ease-in-out both;

    output {
      font-family: Arial, Helvetica, sans-serif;
    }

    img {
      width: 4vmax;
      transform: translateY(0.3vmax);
    }
  }
</style>
