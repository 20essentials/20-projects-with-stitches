<script>
  import gsap from 'gsap';
  import Flip from 'gsap/Flip';
  gsap.registerPlugin(Flip);
  const $ = <T extends Element = HTMLElement>(selector: string) =>
    document.querySelector<T>(selector);
  const $$ = <T extends Element = HTMLElement>(selector: string) =>
    document.querySelectorAll<T>(selector);
  const grid = $<HTMLDivElement>('#grid-demo');
  // const items = gsap.utils.toArray<HTMLElement>('.rg_item');
  const items = $$<HTMLElement>('.rg_item');

  $<HTMLButtonElement>('.rg_btn')?.addEventListener('click', () => {
    const state = Flip.getState(items);
    for (let i = items.length; i >= 0; i--) {
      grid?.appendChild(grid.children[(Math.random() * i) | 0]);
    }
    Flip.from(state, {
      absolute: true
    });
  });
</script>

<section class='am-section'>
  <aside id='grid-demo'>
    <button class='rg_btn' data-rg='grid-demo'>
      <div class='am-text-button'>Shuffle</div>
    </button>
    {
      arrayCards.map(({ id, localImage, repo, title, web }) => (
        <a class='rg_item' href={repo} >
          <img src={baseUrl(localImage)} />
          <div class='rg_item-content'>{title}</div>
        </a>
      ))
    }
  </aside>
</section>

<style>
  #grid-demo {
    min-height: 100vh;
    display: grid;
    padding: 2.2vmax;
    gap: 2.2vmax;
    display: grid;
    position: relative;
    grid-template-columns: repeat(auto-fit, minmax(17vmax, 1fr));
    overflow: hidden;
  }

  .rg_btn {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: -4.5vmax;
    z-index: 500;
    background-color: red;
    width: 9vmax;
    height: 9vmax;

    .am-text-button {
      position: absolute;
      left: 50%;
      transform: translate(-50%, -50%);
      top: 30%;
      font-size: 1.3vmax;
    }
  }

  .rg_item {
    min-width: 15vmax;
    width: 100%;
    text-decoration: none;
    position: relative;

    &:last-child {
      /* scale: 0.1; */
      display: none;
    }
  }

  .rg_item-content {
    font-size: 1.2vmax;
    position: absolute;
    left: 0.8vmax;
    bottom: 0.8vmax;
    z-index: 50;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    border: dashed 0.2vmax var(--color-surface-white);
  }
</style>
